# Stripe API Keys
STRIPE_SECRET_KEY="sk_test_..."                      # Replace with your test secret key
STRIPE_PUBLISHABLE_KEY="pk_test_..."                 # Replace with your publishable key
STRIPE_WEBHOOK_SECRET="whsec_..."                    # Replace with your webhook signing secret
STRIPE_API_VERSION="2025-02-24.acacia"               # Latest stable version

# Stripe Price IDs (create these in Stripe Dashboard → Products)
STRIPE_PRICE_BASIC_MONTHLY_ID="price_1Q..."
STRIPE_PRICE_BASIC_YEARLY_ID="price_1Q..."
STRIPE_PRICE_PRO_MONTHLY_ID="price_1Q..."
STRIPE_PRICE_PRO_YEARLY_ID="price_1Q..."
STRIPE_PRICE_ENTERPRISE_MONTHLY_ID="price_1Q..."
STRIPE_PRICE_ENTERPRISE_YEARLY_ID="price_1Q..."

# Stripe Customer Portal URL (from Stripe Dashboard → Settings → Billing portal)
STRIPE_CUSTOMER_PORTAL_URL="https://billing.stripe.com/p/login/test_..."

# Redirect URLs for Checkout
STRIPE_PAYMENT_SUCCESS_URL="http://localhost:8000/?success=true"
STRIPE_PAYMENT_CANCEL_URL="http://localhost:8000/"

# Database
DATABASE_URL="sqlite:///./subscriptions.db"

# API Key Header (for protected endpoints)
API_KEY_HEADER="X-API-Key"