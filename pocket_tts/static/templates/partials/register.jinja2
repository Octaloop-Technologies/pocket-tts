<div id="view-register" class="view">
    <h1>🎙️ Pocket TTS</h1>
    <p style="text-align:center;">Create your account</p>
    <form id="form-register">
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="reg-email" autocomplete="email" required />
        </div>
        <div class="form-group">
            <label>Password (min 8 chars)</label>
            <input type="password" id="reg-password" autocomplete="new-password" required />
        </div>
        <div class="form-group">
            <label>Confirm Password</label>
            <input type="password" id="reg-confirm" autocomplete="new-password" required />
        </div>
        <div class="form-group">
            <label>Name (optional)</label>
            <input type="text" id="reg-name" autocomplete="name" />
        </div>
        <button type="submit" class="btn">Register</button>
        <div id="reg-error" class="error"></div>
    </form>
    <div class="link-row">
        <a data-view="login">Already have an account? Log in</a>
    </div>
</div>