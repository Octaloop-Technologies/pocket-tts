<div id="view-forgot" class="view">
    <h1>Reset Password</h1>
    <p style="text-align:center;">We'll send you a reset link</p>
    <form id="form-forgot">
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="forgot-email" autocomplete="email" required />
        </div>
        <button type="submit" class="btn">Send Reset Link</button>
        <div id="forgot-message" class="success-msg"></div>
        <div id="forgot-error" class="error"></div>
    </form>
    <div class="link-row">
        <a data-view="login">Back to login</a>
    </div>
</div>