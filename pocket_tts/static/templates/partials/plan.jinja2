<div id="view-plan" class="view">
    <h2>Choose Your Plan</h2>
    <div class="plan-toggle">
        <label><input type="radio" name="interval" value="monthly" checked> Monthly</label>
        <label><input type="radio" name="interval" value="yearly"> Yearly</label>
    </div>
    <div id="plan-cards"></div>
    <button id="next-btn" class="btn next-btn">Next →</button>
    <div id="plan-error" class="error"></div>
</div>