<div id="view-app" class="view">
    <div class="navbar">
        <div><strong>Pocket TTS</strong></div>
        <div class="user-info">
            <span id="user-email" class="badge"></span>
            <span id="plan-badge" class="badge">Plan: Basic</span>
            <span id="remaining-badge" class="badge">Remaining: 0</span>
            <span class="gear" id="settings-gear" title="Manage billing">⚙️</span>
        </div>
    </div>
    <div id="tts-ui">
        <textarea id="text-input" rows="4">Hello world! I am Kyutai Pocket TTS.</textarea>
        <div class="flex-row">
            <input type="text" id="voice-url" placeholder="Optional: voice URL or name (e.g. alba)" />
            <input type="file" id="voice-file" accept=".wav,.mp3" />
        </div>
        <button id="generate-btn" class="btn">Generate Audio</button>
        <div id="status" class="error"></div>
        <div id="audio-section" style="display:none;">
            <h3>Generated Audio</h3>
            <audio id="audio" controls></audio>
            <a id="download-link" class="btn btn-outline" style="display:inline-block;margin-top:0.5rem;">Download</a>
        </div>
        <button id="logout-btn" class="btn btn-outline" style="margin-top:1.5rem;">Logout</button>
    </div>
</div>